<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Checkout Page</title>
</head>
        
<body>
    <h1>Checkout</h1>
    <section>
        <h2>Your Cart</h2>
        <img src="https://images.stockx.com/images/Pop-Mart-Labubu-The-Monsters-Tasty-Macarons-Toffee-Vinyl-Plush-Pendant-Product.jpg" alt="brown stuffed animal">
        <p>Toffee Labubu</p>
        <p>$15.99</p>
    </section>
    <section>
        <h2>Payment Information</h2>
        <form>
            <label for="card-name">Cardholder Name<span aria-hidden="true">*</span></label>
            <input id="card-name" name="card-name" type="text" required>
            <label for="card-number">Card Number<span aria-hidden="true">*</span></label>
            <input id="card-number" name="card-number" type="text" required aria-describedby="card-number-help">
            <p id="card-number-help">Please enter your 16-digit card number without spaces or dashes.</p>
            <button>Place order</button>
            </form>
            </section>
</body>
<!-- Please don't take this checkout page seriously! -->
</html>
